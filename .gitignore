# Generated by Cargo
# Will contain compiled files and executables
/target/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# IDE / OS specific ignores (optional but recommended)
.vscode/
.idea/
.claude/
*.swp
.DS_Store
Thumbs.db

# Note: Cargo.lock should be committed if this MCP is a standalone executable binary. 
# If it is a library crate, you would uncomment the line below to ignore it.
# Cargo.lock
# VB Roslyn sidecar build artifacts
tools/vb_roslyn_sidecar/obj/
tools/vb_roslyn_sidecar/bin/
tools/vb_roslyn_sidecar/publish_out/

# Superpowers plugin scratch (brainstorm notes, not project source)
.superpowers/
# eval secrets + generated data
eval/.secrets/
eval/data/
eval/__pycache__/
